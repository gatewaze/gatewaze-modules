#!/usr/bin/env sh
# Blocking secret-scan gate before anything reaches the remote.
# Enable once per clone:  git config core.hooksPath .githooks
# Requires gitleaks:      brew install gitleaks
# Emergency bypass:       git push --no-verify   (CI still scans)
ZERO=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$ZERO" ] && continue
  if [ "$remote_oid" = "$ZERO" ]; then
    if git rev-parse --verify --quiet origin/HEAD >/dev/null 2>&1; then
      base=$(git merge-base origin/HEAD "$local_oid" 2>/dev/null)
      range="${base:+$base..}$local_oid"
    else
      range="$local_oid"
    fi
  else
    range="$remote_oid..$local_oid"
  fi
  echo "── pre-push: gitleaks ($range) ──"
  if ! sh scripts/security/gitleaks-scan.sh --range "$range"; then fail=1; fi
done
if [ "$fail" -ne 0 ]; then
  echo ""
  echo "✖ pre-push secret gate failed. Fix, or bypass in an emergency: git push --no-verify"
  exit 1
fi
echo "✔ pre-push secret gate passed"
